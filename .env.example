# Copy this file to .env.local for local development.
# In production (Vercel), set these under Project → Settings → Environment Variables instead.

# From your Google service account JSON key:
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# The id in your sheet's URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=your-google-sheet-id

# The domain this landing page will be live on. Use "*" only for local testing.
LEAD_FORM_ALLOWED_ORIGIN=https://feedmasterph.com
